{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rootsrundeepliteracy",
  "main": "worker.js",
  "compatibility_date": "2026-08-11",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RootRoomRoom"
      }
    ]
  },
  "exports": {
    "RootRoomRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}